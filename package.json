{
  "name": "react-step-progress",
  "version": "1.0.3",
  "description": "Multi step and dynamic progress indicator for react",
  "keywords": [
    "react",
    "typescript",
    "hooks",
    "step progress",
    "progress bar"
  ],
  "author": "saini-g",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saini-g/react-step-progress"
  },
  "main": "dist/index.js",
  "module": "dist/react-step-progress.js",
  "source": "src/index.ts",
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js",
    "start-server": "react-scripts start",
    "start": "NODE_ENV=development webpack-dev-server --config ./example/webpack.config.js",
    "prepare": "run-s build",
    "prepublishOnly": "run-s build",
    "test": "run-s test:unit test:lint test:build",
    "test:build": "run-s build",
    "test:lint": "eslint .",
    "test:unit": "cross-env CI=1 react-scripts test --env=jsdom",
    "test:watch": "react-scripts test --env=jsdom",
    "predeploy": "cd example && npm install && npm run build",
    "deploy": "gh-pages -d example/build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.8",
    "babel-loader": "^9.2.1",
    "cross-env": "^7.0.2",
    "css-loader": "^7.1.2",
    "eslint": "^9.20.1",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-node": "^11.0.0",
    "eslint-plugin-prettier": "^3.1.1",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-standard": "^4.0.1",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "webpack-livereload-plugin": "^3.0.2"
  },
  "files": [
    "dist"
  ]
}
